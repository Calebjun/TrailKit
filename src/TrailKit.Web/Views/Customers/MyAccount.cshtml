@* Author: Utsah Tamang. UC4 My Account: rentals, history, charges, deposits. *@
@model TrailKit.Application.Dtos.AccountSummaryDto
@using TrailKit.Domain.Enums
@{ ViewData["Title"] = "My Account"; }
<h1 class="h3">@Model.Name</h1>
<p class="text-muted">@Model.Email</p>

@if (Model.Standing == CustomerStanding.Suspended)
{
    <div class="alert alert-danger">
        <strong>Your account is suspended.</strong> @Model.SuspensionReason
        Pay or ask the store about your charges to reserve gear again.
    </div>
}
else
{
    <div class="alert alert-success">Your account is in good standing.</div>
}

<ul class="nav nav-tabs" role="tablist">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#active" type="button">Active rentals (@Model.ActiveRentals.Count)</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#history" type="button">History (@Model.RentalHistory.Count)</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#charges" type="button">Charges ($@Model.UnpaidTotal.ToString("0.00") unpaid)</button></li>
</ul>

<div class="tab-content pt-3">
    <div class="tab-pane fade show active" id="active">
        @if (!Model.ActiveRentals.Any())
        {
            <p class="text-muted">You have no gear out right now. <a asp-controller="Catalog" asp-action="Index">Browse the catalog</a>.</p>
        }
        else
        {
            <table class="table">
                <thead><tr><th>Gear</th><th>Picked up</th><th>Due</th><th>Deposit</th></tr></thead>
                <tbody>
                @foreach (var r in Model.ActiveRentals)
                {
                    <tr class="@(r.DueDate < DateTime.Today ? "table-warning" : "")">
                        <td>@r.GearName</td><td>@r.PickupDate.ToString("MMM d")</td><td>@r.DueDate.ToString("MMM d")</td>
                        <td>$@r.DepositAmount.ToString("0.00") (@r.DepositStatus)</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>

    <div class="tab-pane fade" id="history">
        @if (!Model.RentalHistory.Any())
        {
            <p class="text-muted">No past rentals yet.</p>
        }
        else
        {
            <table class="table">
                <thead><tr><th>Gear</th><th>Picked up</th><th>Returned</th><th>Deposit</th></tr></thead>
                <tbody>
                @foreach (var r in Model.RentalHistory)
                {
                    <tr><td>@r.GearName</td><td>@r.PickupDate.ToString("MMM d, yyyy")</td>
                        <td>@r.ReturnedDate?.ToString("MMM d, yyyy")</td><td>@r.DepositStatus</td></tr>
                }
                </tbody>
            </table>
        }
    </div>

    <div class="tab-pane fade" id="charges">
        <div class="form-check form-switch mb-2">
            <input class="form-check-input" type="checkbox" id="hideSettled" checked />
            <label class="form-check-label" for="hideSettled">Show only unpaid charges</label>
        </div>
        @if (!Model.Charges.Any())
        {
            <p class="text-muted">No charges. Nice.</p>
        }
        else
        {
            <table class="table" id="chargesTable">
                <thead><tr><th>Date</th><th>Reason</th><th>Amount</th><th>Status</th></tr></thead>
                <tbody>
                @foreach (var c in Model.Charges)
                {
                    <tr data-status="@c.Status">
                        <td>@c.CreatedAtUtc.ToString("MMM d, yyyy")</td><td>@c.Reason</td>
                        <td>$@c.Amount.ToString("0.00")</td>
                        <td>@c.Status@(c.WaivedReason != null ? " (" + c.WaivedReason + ")" : "")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>

@section Scripts {
<script>
    // Show only unpaid charges when the switch is on.
    $(function () {
        function applyFilter() {
            var onlyUnpaid = $('#hideSettled').is(':checked');
            $('#chargesTable tbody tr').each(function () {
                $(this).toggle(!onlyUnpaid || $(this).data('status') === 'Unpaid');
            });
        }
        $('#hideSettled').on('change', applyFilter);
        applyFilter();
    });
</script>
}
