@{
    ViewData["Title"] = "Home";
}
<div class="py-5">
    <h1 class="display-5">Rent the gear. Skip the storage.</h1>
    <p class="lead col-lg-7">Tents, kayaks and bikes for your next trip. Check availability and reserve online.</p>
    @if (User.Identity?.IsAuthenticated != true)
    {
        <a class="btn btn-success btn-lg me-2" asp-controller="Customers" asp-action="Register">Create an account</a>
        <a class="btn btn-outline-secondary btn-lg" asp-controller="Customers" asp-action="Login">Log in</a>
    }
</div>
